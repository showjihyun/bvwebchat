{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "TodoWrite",
      "Skill",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git merge-base:*)",
      "Bash(git ls-files:*)",
      "Bash(git check-ignore:*)",
      "Bash(git blame:*)",
      "Bash(git worktree list)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git switch:*)",
      "Bash(git checkout -b:*)",
      "Bash(git restore:*)",
      "Bash(git rm:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr list:*)",
      "Bash(node scripts/check.mjs:*)",
      "Bash(node scripts/policy-lint.mjs:*)",
      "Bash(node scripts/hooks-selftest.mjs:*)",
      "Bash(node scripts/doc-freshness.mjs:*)",
      "Bash(node scripts/golden-coverage.mjs:*)",
      "Bash(node scripts/metrics.mjs:*)",
      "Bash(node scripts/phase-audit.mjs:*)",
      "Bash(bash scripts/check.sh:*)",
      "Bash(npm test:*)",
      "Bash(npm run:*)",
      "Bash(npx vitest:*)",
      "Bash(npx eslint:*)",
      "Bash(npx tsc:*)",
      "Bash(python harness/phase.py show:*)",
      "Bash(python harness/phase.py why:*)",
      "Bash(python harness/phase.py enter:*)",
      "Bash(python harness/phase.py resume:*)",
      "Bash(python harness/phase.py session:*)",
      "Bash(python harness/phase.py decide:*)",
      "Bash(python .claude/hooks/:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(wc:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(git stash:*)",
      "Bash(git revert:*)",
      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Edit(./evals/golden/**)",
      "Write(./evals/golden/**)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(docker:*)",
      "Bash(npm install:*)",
      "Bash(npm ci:*)",
      "Bash(git worktree add:*)",
      "Bash(git worktree remove:*)",
      "Bash(node scripts/eval-b.mjs:*)",
      "Bash(node scripts/resume-test.mjs:*)",
      "Bash(python harness/phase.py force:*)",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Write(./.env*)",
      "Edit(./.env*)",
      "Write(./.harness/state/**)",
      "Edit(./.harness/state/**)",
      "MultiEdit(./.harness/state/**)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git rebase:*)",
      "Bash(git filter-branch:*)",
      "Bash(git clean -fdx:*)",
      "Bash(chmod 777:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "python .claude/hooks/hook.py session_start" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          { "type": "command", "command": "python .claude/hooks/hook.py gate_phase" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [
          { "type": "command", "command": "python .claude/hooks/hook.py post_observe" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "python .claude/hooks/hook.py log_trajectory" },
          { "type": "command", "command": "python .claude/hooks/hook.py stop_state" }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "python .claude/hooks/hook.py log_trajectory" }
        ]
      }
    ]
  }
}
